# Frontend environment variables (template)
# Copy to .env.local for local development. Never commit the real file.

# API base URL. In development, leave blank to use the Vite proxy
# (requests to /api are forwarded to http://localhost:8000).
# In production set this to your backend URL, e.g. https://api.financeflow.example.com/api/v1
VITE_API_URL=
