# =========================================================
# FinanceFlow environment configuration (TEMPLATE)
# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file.
# =========================================================

# ---- MySQL (used by Docker Compose) ----
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=financeflow
MYSQL_USER=financeflow
MYSQL_PASSWORD=change_me_in_production
MYSQL_ROOT_PASSWORD=change_me_root_in_production

# ---- SQLAlchemy database URL ----
# Format: mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE?charset=utf8mb4
# For local dev without docker, set HOST to 127.0.0.1
DATABASE_URL=mysql+pymysql://financeflow:change_me_in_production@127.0.0.1:3306/financeflow?charset=utf8mb4

# ---- JWT / Auth ----
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace_with_a_strong_random_secret_at_least_32_chars_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- CORS ----
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ---- App ----
APP_NAME=FinanceFlow
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
